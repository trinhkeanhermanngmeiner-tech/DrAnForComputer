<UserControl x:Class="BacSiMayTinh.Pages.OptimizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <UserControl.Resources>
        <!-- Nhãn mức rủi ro -->
        <DataTemplate x:Key="RiskBadge">
            <Border Style="{StaticResource Badge}" Background="{Binding RiskBg}" Margin="8,0,0,0">
                <TextBlock Text="{Binding RiskText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding RiskFg}"/>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{c:T 'Tối ưu hệ thống'}" Style="{StaticResource T.H1}"/>
                <TextBlock Text="{c:T 'Tăng tốc Windows an toàn. Mọi thay đổi đều được sao lưu và có thể hoàn tác.'}"
                           Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Click="RevertAll_Click" ToolTip="{c:T 'Đưa mọi tinh chỉnh và dịch vụ về như trước khi dùng DrAn For Computer'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7A7;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Hoàn tác tất cả'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="LowEnd_Click"
                        ToolTip="{c:T 'Áp dụng một lần bộ tối ưu dành cho máy cấu hình yếu'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Chế độ máy yếu'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource TabBar}" Margin="0,18,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabStartup" Style="{StaticResource TabItem}" GroupName="OptTab" Content="{c:T 'Khởi động cùng Windows'}" Tag="startup" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabTweaks" Style="{StaticResource TabItem}" GroupName="OptTab" Content="{c:T 'Tinh chỉnh'}" Tag="tweaks" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabServices" Style="{StaticResource TabItem}" GroupName="OptTab" Content="{c:T 'Dịch vụ'}" Tag="services" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAppx" Style="{StaticResource TabItem}" GroupName="OptTab" Content="{c:T 'Ứng dụng cài sẵn'}" Tag="appx" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabContext" Style="{StaticResource TabItem}" GroupName="OptTab" Content="{c:T 'Menu chuột phải'}" Tag="context" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- ========== Khởi động ========== -->
            <DockPanel x:Name="StartupPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
                    <TextBlock x:Name="StartupSummary" Style="{StaticResource T.Sub}" VerticalAlignment="Center" Margin="0,0,140,0"
                               Text="{c:T 'Đang tải danh sách…'}"/>
                    <Button HorizontalAlignment="Right" Click="StartupRefresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                            <TextBlock Text="{c:T 'Làm mới'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="StartupList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32">
                                            <Border CornerRadius="8" Background="{DynamicResource B.Card2}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}, ConverterParameter=!}">
                                                <TextBlock Text="&#xE7C3;" Style="{StaticResource T.Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" ToolTip="{Binding Command}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" Margin="0,0,16,0">
                                            <TextBlock Text="{Binding Location}" FontSize="10.5" Foreground="{DynamicResource B.Text2}"/>
                                        </Border>
                                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="StartupToggle_Click"
                                                  ToolTip="{c:T 'Bật/tắt khởi động cùng Windows'}"/>
                                        <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Content="&#xE74D;" Margin="10,0,0,0" Click="StartupDelete_Click"
                                                ToolTip="{c:T 'Xóa hẳn khỏi danh sách khởi động'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ========== Tinh chỉnh ========== -->
            <DockPanel x:Name="TweaksPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" Padding="16,11" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource T.Sub}" Margin="10,0,16,0" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                                   Text="{c:T 'Bật công tắc để áp dụng, tắt để trả về như cũ. Một điểm khôi phục hệ thống sẽ được tạo trước lần thay đổi đầu tiên.'}"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{c:T 'Khởi động lại Explorer'}" Click="RestartExplorer_Click"/>
                            <Button Content="{c:T 'Áp dụng mục khuyên dùng'}" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="ApplyRecommended_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="TweakGroups">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,6">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" Margin="10,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Row}" Padding="12,9">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Margin="0,0,16,0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                                    <ContentPresenter ContentTemplate="{StaticResource RiskBadge}" Content="{Binding}"/>
                                                                    <Border Style="{StaticResource Badge}" Background="#263B9EFF" Margin="6,0,0,0"
                                                                            Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                                                        <TextBlock Text="{c:T 'Khuyên dùng'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#3B9EFF"/>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource T.Sub}" Margin="0,3,0,0"/>
                                                                <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#E8A317" Margin="0,3,0,0" TextWrapping="Wrap"
                                                                           Visibility="{Binding HasNote, Converter={StaticResource BoolVis}}"/>
                                                            </StackPanel>
                                                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                                                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                                          IsEnabled="{Binding IsIdle}" Click="TweakToggle_Click"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ========== Dịch vụ ========== -->
            <DockPanel x:Name="ServicesPanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" Padding="16,11" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource T.Sub}" Margin="10,0,0,0" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                                   Text="{c:T 'Chỉ liệt kê các dịch vụ an toàn để tắt. Bật công tắc = TẮT dịch vụ. Tắt công tắc để khôi phục chế độ khởi động ban đầu.'}"/>
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="ServiceList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                                <ContentPresenter ContentTemplate="{StaticResource RiskBadge}" Content="{Binding}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Sub}" Margin="0,3,0,0"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Muted}"/>
                                                <TextBlock Text="{c:T '  ·  Khởi động: '}" Style="{StaticResource T.Muted}"/>
                                                <TextBlock Text="{Binding StartText}" Style="{StaticResource T.Muted}"/>
                                                <TextBlock Text="  ·  " Style="{StaticResource T.Muted}"/>
                                                <TextBlock Text="{Binding StateText}" FontSize="11.5" Foreground="{Binding StateBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{c:T 'Tắt dịch vụ'}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsDisabled, Mode=TwoWay}" IsEnabled="{Binding IsIdle}" Click="ServiceToggle_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ========== Menu chuột phải ========== -->
            <DockPanel x:Name="ContextPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
                    <TextBlock x:Name="ContextSummary" Style="{StaticResource T.Sub}" VerticalAlignment="Center" Margin="0,0,330,0"
                               Text="{c:T 'Đang tải…'}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="ContextRefresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Làm mới'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Content="{c:T 'Khởi động lại Explorer'}" Margin="8,0,0,0" Click="RestartExplorer_Click"/>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="ContextList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32">
                                            <Border CornerRadius="8" Background="{DynamicResource B.Card2}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}, ConverterParameter=!}">
                                                <TextBlock Text="&#xE8A5;" Style="{StaticResource T.Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Location}" FontSize="10.5" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                            <Border Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}">
                                                <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                        </StackPanel>
                                        <CheckBox Grid.Column="3" Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="ContextToggle_Click"
                                                  ToolTip="{c:T 'Bật/tắt mục này trong menu chuột phải'}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ========== Ứng dụng cài sẵn ========== -->
            <DockPanel x:Name="AppxPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="2,0,0,10">
                    <StackPanel Margin="0,0,320,0">
                        <TextBlock x:Name="AppxSummary" Style="{StaticResource T.Sub}" Text="{c:T 'Đang tải danh sách ứng dụng…'}"/>
                        <CheckBox x:Name="AppxShowAll" Content="{c:T 'Hiện tất cả ứng dụng từ Microsoft Store'}" Margin="0,8,0,0" Click="AppxShowAll_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Click="AppxRefresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Làm mới'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AppxRemoveBtn" Style="{StaticResource Btn.Danger}" Margin="8,0,0,0" Click="AppxRemove_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Gỡ ứng dụng đã chọn'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="AppxList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,9">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <StackPanel Margin="14,0,0,0">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
