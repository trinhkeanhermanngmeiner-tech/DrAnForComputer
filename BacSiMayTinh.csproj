<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BacSiMayTinh</RootNamespace>
    <AssemblyName>DrAnForComputer</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>

    <Product>DrAn For Computer</Product>
    <AssemblyTitle>DrAn For Computer - Tối ưu &amp; dọn dẹp máy tính</AssemblyTitle>
    <Company>BS. Trịnh Kế An</Company>
    <Authors>BS. Trịnh Kế An</Authors>
    <Copyright>© 2026 BS. Trịnh Kế An</Copyright>
    <Description>DrAn For Computer - phần mềm tối ưu, dọn dẹp và sửa lỗi Windows. Tác giả: BS. Trịnh Kế An</Description>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <NeutralLanguage>vi-VN</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\donate_qr.png" />
  </ItemGroup>

</Project>
