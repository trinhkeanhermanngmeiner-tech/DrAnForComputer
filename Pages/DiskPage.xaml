<UserControl x:Class="BacSiMayTinh.Pages.DiskPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{c:T 'Phân tích ổ đĩa'}" Style="{StaticResource T.H1}"/>
            <TextBlock Text="{c:T 'Xem thư mục nào đang chiếm nhiều dung lượng nhất, tìm tệp lớn và tệp trùng lặp để giải phóng ổ cứng.'}"
                       Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border x:Name="ScanCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="TargetBox" Width="260"/>
                <Button Grid.Column="1" Margin="8,0,0,0" Click="Browse_Click" ToolTip="{c:T 'Chọn một thư mục để phân tích'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" Style="{StaticResource T.Icon}" FontSize="12"/>
                        <TextBlock Text="{c:T 'Chọn thư mục…'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Margin="16,0,12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressText" Style="{StaticResource T.Muted}" Text="{c:T 'Chọn ổ đĩa rồi bấm « Phân tích ».'}"/>
                    <ProgressBar x:Name="Progress" IsIndeterminate="True" Margin="0,6,0,0" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="CancelBtn" Content="{c:T 'Dừng'}" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
                    <Button x:Name="ScanBtn" Style="{StaticResource Btn.Primary}" Click="Scan_Click" MinWidth="120">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="12"/>
                            <TextBlock x:Name="ScanBtnText" Text="{c:T 'Phân tích'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource TabBar}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabFolders" Style="{StaticResource TabItem}" GroupName="DiskTab" Content="{c:T 'Dung lượng thư mục'}" Tag="folders" Checked="Tab_Checked" IsChecked="True"/>
                <RadioButton x:Name="TabFiles" Style="{StaticResource TabItem}" GroupName="DiskTab" Content="{c:T 'Tệp lớn nhất'}" Tag="files" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDups" Style="{StaticResource TabItem}" GroupName="DiskTab" Content="{c:T 'Tệp trùng lặp'}" Tag="dups" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabSpeed" Style="{StaticResource TabItem}" GroupName="DiskTab" Content="{c:T 'Tốc độ &amp; USB giả'}" Tag="speed" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <!-- ===== Thư mục ===== -->
            <Border x:Name="FoldersPanel" Style="{StaticResource Card}" Padding="6">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,6,10,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="UpBtn" Style="{StaticResource Btn.Icon}" Content="&#xE74A;" Click="Up_Click" ToolTip="{c:T 'Lên thư mục cha'}" IsEnabled="False"/>
                            <TextBlock x:Name="PathText" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                            <TextBlock x:Name="PathSize" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource T.Muted}"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Content="{c:T 'Mở trong Explorer'}" Click="OpenFolder_Click"/>
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom" Text="{c:T 'Mẹo: nhấp đúp vào một thư mục để xem bên trong.'}" Style="{StaticResource T.Muted}" Margin="12,6,0,4"/>
                    <ListBox x:Name="FolderList" Style="{StaticResource PlainList}" MouseDoubleClick="Folder_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="#E8A317"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FilesText}" Style="{StaticResource T.Muted}"/>
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,0,46,0"/>
                                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Tệp lớn ===== -->
            <Border x:Name="FilesPanel" Style="{StaticResource Card}" Padding="6" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,6,10,8">
                        <TextBlock x:Name="FilesSummary" Style="{StaticResource T.Sub}" VerticalAlignment="Center" Text="{c:T 'Hãy phân tích ổ đĩa trước.'}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Danger}" Click="DeleteFiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Xóa đã chọn (vào Thùng rác)'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox x:Name="FileList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsDeleted, Converter={StaticResource Not}}"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource T.Muted}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Content="&#xE8DA;" ToolTip="{c:T 'Mở vị trí tệp'}" Click="ShowFile_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ===== Trùng lặp ===== -->
            <Border x:Name="DupsPanel" Style="{StaticResource Card}" Padding="6" Visibility="Collapsed">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,6,10,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{c:T 'Chỉ tìm tệp lớn hơn'}" VerticalAlignment="Center" Style="{StaticResource T.Sub}"/>
                            <ComboBox x:Name="MinSizeBox" Width="110" Margin="10,0,0,0">
                                <ComboBoxItem Content="1 MB" Tag="1"/>
                                <ComboBoxItem Content="10 MB" Tag="10" IsSelected="True"/>
                                <ComboBoxItem Content="100 MB" Tag="100"/>
                            </ComboBox>
                            <Button x:Name="DupScanBtn" Margin="10,0,0,0" Content="{c:T 'Tìm tệp trùng lặp'}" Click="DupScan_Click"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Danger}" Click="DeleteDups_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Xóa bản sao đã chọn'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="DupSummary" DockPanel.Dock="Top" Style="{StaticResource T.Muted}" Margin="12,0,0,6"
                               Text="{c:T 'Bỏ qua thư mục Windows và Program Files. Bản cũ nhất trong mỗi nhóm được giữ lại, các bản sao được chọn sẵn.'}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DupList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,4,8,8" Padding="10,8" CornerRadius="8" Background="{DynamicResource B.Card2}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Muted}" Margin="0,1,0,4"/>
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,3">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="90"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsDeleted, Converter={StaticResource Not}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Path}" Margin="10,0,8,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                                            <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="26" Height="26" Content="&#xE8DA;" ToolTip="{c:T 'Mở vị trí tệp'}" Click="ShowFile_Click"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- ===== Tốc độ & USB giả dung lượng ===== -->
            <ScrollViewer x:Name="SpeedPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{c:T 'Đo tốc độ ổ đĩa và kiểm tra USB/thẻ nhớ giả dung lượng'}" Style="{StaticResource T.H3}"/>
                            <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,12"
                                       Text="{c:T 'Ghi dữ liệu thử vào phần trống rồi đọc lại để kiểm tra từng byte. Dữ liệu có sẵn trên ổ không bị ảnh hưởng, tệp thử được xóa khi xong.'}"/>
                            <WrapPanel>
                                <ComboBox x:Name="SpeedDrive" Width="320" Margin="0,0,8,8"/>
                                <Button x:Name="SpeedBtn" Margin="0,0,8,8" Click="Speed_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEC4A;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                        <TextBlock Text="{c:T 'Đo tốc độ (1 GB)'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FakeBtn" Style="{StaticResource Btn.Primary}" Margin="0,0,8,8" Click="Fake_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE88E;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                        <TextBlock Text="{c:T 'Kiểm tra dung lượng thật'}" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SpeedStopBtn" Content="{c:T 'Dừng'}" Margin="0,0,8,8" Click="SpeedStop_Click" Visibility="Collapsed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <UniformGrid Columns="3" Margin="0,12,0,0">
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{c:T 'TỐC ĐỘ GHI'}" Style="{StaticResource T.Muted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="WriteText" Text="--" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{c:T 'TỐC ĐỘ ĐỌC'}" Style="{StaticResource T.Muted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ReadText" Text="--" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="{c:T 'DỮ LIỆU ĐÃ KIỂM TRA'}" Style="{StaticResource T.Muted}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="VerifyText" Text="--" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock x:Name="SpeedPhase" Style="{StaticResource T.Sub}" Text="{c:T 'Chọn ổ đĩa rồi bấm « Đo tốc độ » hoặc « Kiểm tra dung lượng thật ».'}"/>
                            <ProgressBar x:Name="SpeedProgress" Maximum="100" Height="8" Margin="0,10,0,0"/>
                            <TextBlock x:Name="SpeedResult" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <TextBlock x:Name="SpeedResultSub" Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="10" Background="{DynamicResource B.AccentSoft}" Padding="16,12" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                            <TextBlock Style="{StaticResource T.Sub}" Foreground="{DynamicResource B.Text}"
                                       Text="{c:T 'USB/thẻ nhớ giả dung lượng: bị sửa để báo 64–128 GB nhưng thực chất chỉ 4–8 GB. Khi chép quá dung lượng thật, dữ liệu bị hỏng âm thầm. Hãy kiểm tra USB/thẻ nhớ mới mua trước khi dùng.'}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
