<UserControl x:Class="BacSiMayTinh.Pages.CleanerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="{c:T 'Dọn rác'}" Style="{StaticResource T.H1}"/>
                <TextBlock Text="{c:T 'Xóa tệp tạm, bộ đệm và dữ liệu thừa để giải phóng dung lượng. Không đụng tới tài liệu, ảnh hay mật khẩu của bạn.'}"
                           Style="{StaticResource T.Sub}" Margin="0,4,0,0" MaxWidth="620" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ScanBtn" Click="Scan_Click" MinWidth="96">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Quét'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CleanBtn" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="Clean_Click" MinWidth="120" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Dọn dẹp'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,14" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource B.AccentGrad}">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SummaryTitle" Text="{c:T 'Bấm « Quét » để tìm tệp rác'}" Style="{StaticResource T.H2}" FontSize="18"/>
                    <TextBlock x:Name="SummarySub" Text="{c:T 'Quá trình quét chỉ đọc, không xóa gì cho tới khi bạn bấm « Dọn dẹp ».'}" Style="{StaticResource T.Sub}" Margin="0,3,0,0"/>
                    <ProgressBar x:Name="Progress" Margin="0,10,0,0" Visibility="Collapsed" Maximum="100"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="GroupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="8,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="10,2,12,6">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding AllChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Margin="14,0,0,0" Foreground="{DynamicResource B.Accent}"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding TotalText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Row}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}"/>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None" Margin="0,1,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                                                            <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="11" Foreground="#E8A317"/>
                                                            <TextBlock Text="{Binding Warning}" FontSize="11.5" Foreground="#E8A317" Margin="6,0,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                        <TextBlock Text="{Binding Status}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,2,0,0">
            <Grid>
                <StackPanel Margin="0,0,180,0">
                    <TextBlock Text="{c:T 'Dọn sâu hệ thống (WinSxS)'}" Style="{StaticResource T.H3}"/>
                    <TextBlock Text="{c:T 'Xóa các bản cập nhật Windows cũ đã được thay thế bằng công cụ DISM của Microsoft. Thường giải phóng 1–5 GB, mất 5–15 phút.'}"
                               Style="{StaticResource T.Sub}" Margin="0,3,0,0"/>
                </StackPanel>
                <Button x:Name="DeepBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Deep_Click" MinWidth="150">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Dọn sâu'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
