<UserControl x:Class="BacSiMayTinh.Pages.DriversPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{c:T 'Driver'}" Style="{StaticResource T.H1}"/>
            <TextBlock Text="{c:T 'Kiểm tra, sao lưu, phục hồi và cập nhật driver từ nguồn chính thức của Microsoft. Driver cũ luôn được sao lưu trước khi cập nhật để quay lại khi cần.'}"
                       Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource TabBar}" Margin="0,16,0,14">
            <StackPanel x:Name="Tabs" Orientation="Horizontal">
                <RadioButton Style="{StaticResource TabItem}" GroupName="DrvTab" Content="{c:T 'Driver đang dùng'}" Tag="installed" Checked="Tab_Checked" IsChecked="True"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="DrvTab" Content="{c:T 'Cập nhật driver'}" Tag="update" Checked="Tab_Checked"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="DrvTab" Content="{c:T 'Dọn driver cũ'}" Tag="store" Checked="Tab_Checked"/>
                <RadioButton Style="{StaticResource TabItem}" GroupName="DrvTab" Content="{c:T 'Lịch sử &amp; quay lại'}" Tag="history" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- ================= Driver đang dùng ================= -->
            <DockPanel x:Name="InstalledPanel">
                <Border x:Name="ProblemCard" DockPanel.Dock="Top" CornerRadius="12" Background="#26EF4B4B" BorderBrush="#66EF4B4B" BorderThickness="1"
                        Padding="16,12" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" Foreground="#EF4B4B" FontSize="16"/>
                                <TextBlock x:Name="ProblemTitle" FontWeight="SemiBold" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="{c:T 'Quét lại phần cứng'}" Click="Scan_Click"/>
                                <Button Content="{c:T 'Tìm driver qua Windows Update'}" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="FindForProblem_Click"/>
                            </StackPanel>
                        </Grid>
                        <ItemsControl x:Name="ProblemList" Margin="26,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="•"/> <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text=" – "/><Run Text="{Binding CodeText, Mode=OneWay}" Foreground="{DynamicResource B.Text2}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="SearchBox" Width="230" TextChanged="Search_Changed" ToolTip="{c:T 'Tìm theo tên thiết bị, hãng…'}"/>
                        <CheckBox x:Name="InboxBox" Content="{c:T 'Hiện cả driver có sẵn của Windows'}" Margin="14,0,0,0" VerticalAlignment="Center" Click="Inbox_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Click="InstallFolder_Click" ToolTip="{c:T 'Nạp và cài driver từ thư mục sao lưu hoặc thư mục driver tải từ trang hãng'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Phục hồi từ thư mục…'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Margin="8,0,0,0" Click="BackupSelected_Click">
                            <TextBlock Text="{c:T 'Sao lưu mục đã chọn'}"/>
                        </Button>
                        <Button Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="BackupAll_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Sao lưu tất cả'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="InstalledSummary" DockPanel.Dock="Top" Style="{StaticResource T.Sub}" Margin="2,0,0,8"/>

                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="DriverList" Style="{StaticResource PlainList}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding IsThirdParty}"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource Badge}" Background="#26E8A317" Margin="8,0,0,0" Visibility="{Binding HasAge, Converter={StaticResource BoolVis}}">
                                                    <TextBlock Text="{Binding AgeText}" FontSize="10.5" FontWeight="SemiBold" Foreground="#E8A317"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ClassText}" FontSize="11" Foreground="{DynamicResource B.Text2}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ================= Cập nhật driver ================= -->
            <DockPanel x:Name="UpdatePanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="14" Background="{DynamicResource B.AccentGrad}">
                            <TextBlock Text="&#xE895;" Style="{StaticResource T.Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateTitle" Text="{c:T 'Cập nhật driver qua Windows Update'}" Style="{StaticResource T.H2}"/>
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource T.Sub}" Margin="0,3,0,0"
                                       Text="{c:T 'Chỉ lấy driver có chữ ký số từ Microsoft và hãng sản xuất. Trước khi cài, driver đang dùng được sao lưu và một điểm khôi phục được tạo.'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="SearchBtn" Height="42" MinWidth="140" Click="SearchUpdates_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13"/>
                                    <TextBlock Text="{c:T 'Tìm bản mới'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="InstallBtn" Style="{StaticResource Btn.Primary}" Height="42" MinWidth="150" Margin="8,0,0,0" Click="InstallUpdates_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="13"/>
                                    <TextBlock Text="{c:T 'Cài mục đã chọn'}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="VendorCard" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{c:T 'Công cụ cập nhật của hãng (driver mới nhất, có cả BIOS)'}" FontWeight="SemiBold"/>
                            <Button Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Content="{c:T 'Bỏ ẩn các bản đã ẩn'}" Click="Unhide_Click"/>
                        </Grid>
                        <ItemsControl x:Name="VendorList" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,4,8,0" Click="Vendor_Click" ToolTip="{Binding Url}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                            <TextBlock Margin="8,0,0,0"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  –  "/><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource B.Text2}"/></TextBlock>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <StackPanel x:Name="UpdateEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <c:Spinner x:Name="UpdateSpinner" Visibility="Collapsed" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                            <TextBlock x:Name="UpdateEmptyText" Style="{StaticResource T.Sub}" TextAlignment="Center" MaxWidth="520"
                                       Text="{c:T 'Bấm « Tìm bản mới » để kiểm tra driver mới cho máy của bạn (mất khoảng 1–3 phút).'}"/>
                        </StackPanel>
                        <ListBox x:Name="UpdateList" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="UpdateCheck_Click"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" Margin="0,2,0,0"
                                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ClassText}" FontSize="11" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                            <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Content="&#xED1A;" Margin="6,0,0,0" ToolTip="{c:T 'Ẩn bản này (Windows sẽ không tự cài)'}" Click="HideUpdate_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ================= Dọn driver cũ ================= -->
            <DockPanel x:Name="StorePanel" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" CornerRadius="10" Background="{DynamicResource B.AccentSoft}" Padding="16,11" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource T.Sub}" Margin="10,0,16,0" Foreground="{DynamicResource B.Text}" VerticalAlignment="Center"
                                   Text="{c:T 'Mỗi lần cập nhật, Windows giữ lại bản driver cũ trong ổ C. Chỉ những bản cũ đã có bản mới hơn và không thiết bị nào đang dùng mới được liệt kê.'}"/>
                        <Button Grid.Column="2" Content="{c:T 'Quét'}" MinWidth="90" Click="StoreScan_Click"/>
                    </Grid>
                </Border>
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <CheckBox x:Name="StoreBackup" Content="{c:T 'Sao lưu các gói trước khi xóa (vào nơi lưu bản sao lưu)'}" IsChecked="True" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="StoreTotal" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="StoreCleanBtn" Style="{StaticResource Btn.Primary}" MinWidth="150" Height="40" Click="StoreClean_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="13"/>
                                <TextBlock Text="{c:T 'Xóa gói đã chọn'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <TextBlock x:Name="StoreEmpty" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Text="{c:T 'Bấm « Quét » để tìm driver cũ trùng lặp.'}"/>
                        <ListBox x:Name="StoreList" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Click="StoreCheck_Click"/>
                                            <StackPanel Grid.Column="1" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>

            <!-- ================= Lịch sử ================= -->
            <DockPanel x:Name="HistoryPanel" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Sub}" Margin="2,0,0,10" TextWrapping="Wrap"
                           Text="{c:T 'Các driver đã cập nhật bằng DrAn For Computer. « Quay lại bản cũ » gỡ gói driver mới, thiết bị tự dùng lại driver trước đó (cài lại từ bản sao lưu nếu cần).'}"/>
                <Border Style="{StaticResource Card}" Padding="6">
                    <Grid>
                        <TextBlock x:Name="HistoryEmpty" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="{c:T 'Chưa có driver nào được cập nhật bằng DrAn For Computer.'}"/>
                        <ListBox x:Name="HistoryList" Style="{StaticResource PlainList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="12,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="{c:T 'Quay lại bản cũ'}" Click="Rollback_Click" Visibility="{Binding CanRollback, Converter={StaticResource BoolVis}}"/>
                                                <Button Style="{StaticResource Btn.Icon}" Content="&#xE838;" Margin="6,0,0,0" ToolTip="{c:T 'Mở thư mục sao lưu driver cũ'}" Click="HistoryFolder_Click"
                                                        Visibility="{Binding BackupDir, Converter={StaticResource BoolVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
