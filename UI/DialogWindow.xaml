<Window x:Class="BacSiMayTinh.UI.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" Width="500"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource B.Text}"
        TextOptions.TextFormattingMode="Display">
    <Border Margin="16" Style="{StaticResource Card}" Padding="24,22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBg" Width="38" Height="38" CornerRadius="10">
                    <TextBlock x:Name="IconText" Style="{StaticResource T.Icon}" HorizontalAlignment="Center" FontSize="18"/>
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource T.H2}" Margin="12,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="380"/>
            </StackPanel>
            <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                <TextBlock x:Name="MessageText" Style="{StaticResource T.Sub}" FontSize="13" LineHeight="20"/>
            </ScrollViewer>
            <ContentControl x:Name="Extra" Margin="0,10,0,0" Focusable="False"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="{c:T 'Hủy'}" MinWidth="96" Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="OkBtn" Content="{c:T 'Đồng ý'}" MinWidth="96" Margin="8,0,0,0" Style="{StaticResource Btn.Primary}" Click="Ok_Click" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
