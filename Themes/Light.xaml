<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="B.Bg" Color="#F2F5F9"/>
    <SolidColorBrush x:Key="B.Sidebar" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B.Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B.Card2" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="B.Hover" Color="#EAF0F6"/>
    <SolidColorBrush x:Key="B.HoverOverlay" Color="#000000"/>
    <SolidColorBrush x:Key="B.Border" Color="#DFE6EE"/>
    <SolidColorBrush x:Key="B.Text" Color="#0F1B2A"/>
    <SolidColorBrush x:Key="B.Text2" Color="#4A5B70"/>
    <SolidColorBrush x:Key="B.Text3" Color="#90A0B3"/>
    <SolidColorBrush x:Key="B.Accent" Color="#0E9F76"/>
    <SolidColorBrush x:Key="B.Accent2" Color="#0B7CC4"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="#1F0E9F76"/>
    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0FA97C" Offset="0"/>
        <GradientStop Color="#1279C4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.Input" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="B.Track" Color="#E3E9F0"/>
    <SolidColorBrush x:Key="B.Console" Color="#0F1B2A"/>
    <SolidColorBrush x:Key="B.ConsoleText" Color="#A7E9CB"/>
    <SolidColorBrush x:Key="B.Overlay" Color="#80101A26"/>
    <SolidColorBrush x:Key="B.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="B.Warn" Color="#D97706"/>
    <SolidColorBrush x:Key="B.Ok" Color="#16A34A"/>
    <SolidColorBrush x:Key="B.Info" Color="#2563EB"/>
</ResourceDictionary>
