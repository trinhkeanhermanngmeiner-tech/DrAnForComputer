<UserControl x:Class="BacSiMayTinh.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,0,32,28">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="Greeting" Style="{StaticResource T.H1}" Text="{c:T 'Xin chào!'}"/>
                    <TextBlock Style="{StaticResource T.Sub}" Margin="0,4,0,0" Text="{c:T 'DrAn For Computer đã khám tổng quát cho máy của bạn. Đây là kết quả.'}"/>
                </StackPanel>
                <Button x:Name="RescanBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Rescan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="13"/>
                        <TextBlock Text="{c:T 'Khám lại'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Điểm sức khỏe -->
                <Border Style="{StaticResource Card}" Padding="22">
                    <StackPanel>
                        <TextBlock Text="{c:T 'SỨC KHỎE MÁY TÍNH'}" Style="{StaticResource T.Muted}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <Grid Width="190" Height="190" Margin="0,10,0,0">
                            <c:RingGauge x:Name="Gauge" Thickness="14" TrackBrush="{DynamicResource B.Track}" Value="0"/>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="ScoreText" Text="--" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ScoreLabel" Text="{c:T 'Đang khám…'}" Style="{StaticResource T.Sub}" HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="HealthText" Style="{StaticResource T.Sub}" TextAlignment="Center" Margin="0,4,0,0" MinHeight="36"
                                   Text="{c:T 'Đang kiểm tra rác, khởi động, ổ đĩa, RAM…'}"/>
                        <Button x:Name="QuickBtn" Style="{StaticResource Btn.Primary}" Height="46" Margin="0,12,0,0" FontSize="15" Click="Quick_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource T.Icon}" FontSize="16"/>
                                <TextBlock Text="{c:T 'Tối ưu ngay'}" Margin="10,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="QuickStatus" Style="{StaticResource T.Muted}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Text="{c:T 'Dọn rác an toàn + giải phóng RAM + làm mới DNS'}"/>
                    </StackPanel>
                </Border>

                <!-- Thông số trực tiếp -->
                <UniformGrid Grid.Column="2" Rows="2" Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#263B9EFF">
                                        <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" Foreground="#3B9EFF" HorizontalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="CPU" Style="{StaticResource T.H3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="CpuValue" Text="--%" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="CpuName" DockPanel.Dock="Bottom" Style="{StaticResource T.Muted}"/>
                            <c:Sparkline x:Name="CpuSpark" Stroke="#3B9EFF" Margin="0,10,0,8" MinHeight="44"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,0,8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#26A78BFA">
                                        <TextBlock Text="&#xE964;" Style="{StaticResource T.Icon}" Foreground="#A78BFA" HorizontalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="RAM" Style="{StaticResource T.H3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="RamValue" Text="--%" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid DockPanel.Dock="Bottom">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RamDetail" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Link}" Content="{c:T 'Giải phóng'}" Click="FreeRam_Click"/>
                            </Grid>
                            <c:Sparkline x:Name="RamSpark" Stroke="#A78BFA" Margin="0,10,0,8" MinHeight="44"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,8,8,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#2622B573">
                                        <TextBlock Text="&#xEDA2;" Style="{StaticResource T.Icon}" Foreground="#22B573" HorizontalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock x:Name="DiskTitle" Text="{c:T 'Ổ C:'}" Style="{StaticResource T.H3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    <Border x:Name="DiskTypeBadge" Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" Margin="8,0,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="DiskTypeText" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text2}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="DiskValue" Text="--%" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock x:Name="DiskDetail" DockPanel.Dock="Bottom" Style="{StaticResource T.Muted}"/>
                            <ProgressBar x:Name="DiskBar" Height="8" Maximum="100" VerticalAlignment="Center" Margin="0,10,0,8"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="8,8,0,0">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="30" CornerRadius="8" Background="#26E8A317">
                                        <TextBlock Text="&#xE701;" Style="{StaticResource T.Icon}" Foreground="#E8A317" HorizontalAlignment="Center" FontSize="14"/>
                                    </Border>
                                    <TextBlock Text="{c:T 'Mạng'}" Style="{StaticResource T.H3}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="NetValue" Text="--" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="UptimeText" DockPanel.Dock="Bottom" Style="{StaticResource T.Muted}"/>
                            <c:Sparkline x:Name="NetSpark" Stroke="#E8A317" Max="0" Margin="0,10,0,8" MinHeight="44"/>
                        </DockPanel>
                    </Border>
                </UniformGrid>
            </Grid>

            <!-- Gợi ý -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}"/>
                        <TextBlock Text="{c:T 'Chẩn đoán &amp; lời khuyên của Bác sĩ'}" Style="{StaticResource T.H2}" Margin="10,0,0,0"/>
                    </StackPanel>
                    <ItemsControl x:Name="SuggestionList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="10,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="17" Background="{Binding Bg}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{Binding Fg}" HorizontalAlignment="Center" FontSize="15"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Sub}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ActionText}" Visibility="{Binding ActionVisibility}" Click="Suggestion_Click" VerticalAlignment="Center" MinWidth="96"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Thao tác nhanh -->
            <TextBlock Text="{c:T 'Thao tác nhanh'}" Style="{StaticResource T.H2}" Margin="2,22,0,10"/>
            <UniformGrid Columns="5">
                <UniformGrid.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                        <Setter Property="Background" Value="{DynamicResource B.Card}"/>
                        <Setter Property="Height" Value="92"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                    </Style>
                </UniformGrid.Resources>
                <Button Click="QA_Clean">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="{DynamicResource B.Accent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Dọn rác'}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="FreeRam_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE964;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="#A78BFA" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Giải phóng RAM'}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="QA_Startup">
                    <StackPanel>
                        <TextBlock Text="&#xE7E8;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="#3B9EFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Ứng dụng khởi động'}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="QA_Repair">
                    <StackPanel>
                        <TextBlock Text="&#xE90F;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="#E8A317" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Sửa lỗi Windows'}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Click="QA_LowEnd" Margin="0">
                    <StackPanel>
                        <TextBlock Text="&#xEC4A;" Style="{StaticResource T.Icon}" FontSize="22" Foreground="#EF4B4B" HorizontalAlignment="Center"/>
                        <TextBlock Text="{c:T 'Chế độ máy yếu'}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
