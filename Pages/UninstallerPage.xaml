<UserControl x:Class="BacSiMayTinh.Pages.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <Grid>
        <Grid Margin="32,0,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{c:T 'Quản lý phần mềm'}" Style="{StaticResource T.H1}"/>
                <TextBlock Text="{c:T 'Gỡ sạch ứng dụng không dùng, cập nhật hàng loạt và cài nhanh phần mềm phổ biến từ nguồn chính thức.'}"
                           Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource TabBar}" Margin="0,16,0,14">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TabItem}" GroupName="SwTab" Content="{c:T 'Gỡ cài đặt'}" Tag="remove" Checked="Tab_Checked" IsChecked="True"/>
                    <RadioButton x:Name="TabUpdate" Style="{StaticResource TabItem}" GroupName="SwTab" Content="{c:T 'Cập nhật phần mềm'}" Tag="update" Checked="Tab_Checked"/>
                    <RadioButton x:Name="TabInstall" Style="{StaticResource TabItem}" GroupName="SwTab" Content="{c:T 'Cài nhanh phần mềm'}" Tag="install" Checked="Tab_Checked"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
            <DockPanel x:Name="RemovePanel">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
                    <TextBox x:Name="SearchBox" Padding="34,7,8,7" TextChanged="Search_Changed"/>
                    <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="13" Foreground="{DynamicResource B.Text3}" Margin="12,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock x:Name="SearchHint" Text="{c:T 'Tìm phần mềm theo tên hoặc nhà phát hành…'}" Foreground="{DynamicResource B.Text3}"
                               Margin="35,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <ComboBox x:Name="SortBox" Grid.Column="1" Width="190" Margin="12,0,0,0" SelectionChanged="Sort_Changed">
                    <ComboBoxItem Content="{c:T 'Sắp xếp: Tên A–Z'}" IsSelected="True"/>
                    <ComboBoxItem Content="{c:T 'Sắp xếp: Dung lượng'}"/>
                    <ComboBoxItem Content="{c:T 'Sắp xếp: Mới cài gần đây'}"/>
                </ComboBox>
                <Button Grid.Column="2" Margin="8,0,0,0" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                        <TextBlock Text="{c:T 'Làm mới'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="6">
                <DockPanel>
                    <TextBlock x:Name="Summary" DockPanel.Dock="Top" Style="{StaticResource T.Muted}" Margin="12,6,0,6" Text="{c:T 'Đang tải…'}"/>
                    <ListBox x:Name="AppList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32">
                                            <Border CornerRadius="8" Background="{DynamicResource B.Card2}" Visibility="{Binding HasIcon, Converter={StaticResource BoolVis}, ConverterParameter=!}">
                                                <TextBlock Text="&#xE7B8;" Style="{StaticResource T.Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource B.Text2}"/>
                                            </Border>
                                            <Image Source="{Binding Icon}" Width="28" Height="28"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Body}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource T.Muted}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                        <Button Grid.Column="4" Content="{c:T 'Gỡ cài đặt'}" Click="Uninstall_Click" Padding="14,6"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            </DockPanel>

            <!-- ===== Cập nhật phần mềm ===== -->
            <DockPanel x:Name="UpdatePanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
                    <TextBlock x:Name="UpdSummary" Style="{StaticResource T.Sub}" VerticalAlignment="Center" Margin="0,0,360,0"
                               Text="{c:T 'Kiểm tra phiên bản mới của các phần mềm đã cài qua Windows Package Manager (winget).'}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="UpdCheckBtn" Click="UpdCheck_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Kiểm tra cập nhật'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdRunBtn" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="UpdRun_Click" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="12"/>
                                <TextBlock Text="{c:T 'Cập nhật đã chọn'}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border x:Name="UpdLogPanel" DockPanel.Dock="Bottom" CornerRadius="10" Background="{DynamicResource B.Console}" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="UpdLog" Height="110" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B.ConsoleText}"
                             FontFamily="Consolas" FontSize="12" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </Border>
                <Border Style="{StaticResource Card}" Padding="6">
                    <ListBox x:Name="UpdList" Style="{StaticResource PlainList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Row}" Padding="12,9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Id}" Style="{StaticResource T.Muted}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Status}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>

            <!-- ===== Cài nhanh ===== -->
            <DockPanel x:Name="InstallPanel" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="2,0,0,12">
                    <TextBlock x:Name="InsSummary" Style="{StaticResource T.Sub}" VerticalAlignment="Center" Margin="0,0,220,0"
                               Text="{c:T 'Chọn phần mềm cần cài – tải trực tiếp từ nguồn chính thức của nhà phát hành, cài tự động không cần bấm Next.'}"/>
                    <Button x:Name="InsRunBtn" HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}" Click="InsRun_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="12"/>
                            <TextBlock Text="{c:T 'Cài đặt đã chọn'}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>
                <Border x:Name="InsLogPanel" DockPanel.Dock="Bottom" CornerRadius="10" Background="{DynamicResource B.Console}" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="InsLog" Height="110" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource B.ConsoleText}"
                             FontFamily="Consolas" FontSize="12" Padding="10,8" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="CatalogList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource T.H3}" Margin="2,0,0,8"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,10,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                                <Border Style="{StaticResource Badge}" Background="#2622B573" Margin="6,0,0,0"
                                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVis}}">
                                                                    <TextBlock Text="{c:T 'Đã cài'}" FontSize="10" FontWeight="SemiBold" Foreground="#22B573"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Description}" Style="{StaticResource T.Muted}" TextWrapping="Wrap" TextTrimming="None"/>
                                                            <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource B.Accent}"
                                                                       Visibility="{Binding HasStatus, Converter={StaticResource BoolVis}}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Chưa có winget -->
            <Border x:Name="NoWingetPanel" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{c:T 'Máy chưa có Windows Package Manager (winget)'}" Style="{StaticResource T.H3}"/>
                    <TextBlock Text="{c:T 'Tính năng này cần ứng dụng « App Installer » của Microsoft (có sẵn trên Windows 11 và Windows 10 bản mới). Hãy cài từ Microsoft Store rồi mở lại trang này.'}"
                               Style="{StaticResource T.Sub}" Margin="0,6,0,12"/>
                    <Button HorizontalAlignment="Left" Content="{c:T 'Mở Microsoft Store'}" Click="OpenStore_Click"/>
                </StackPanel>
            </Border>
            </Grid>
        </Grid>

        <!-- ===== Lớp phủ quá trình gỡ ===== -->
        <Grid x:Name="Overlay" Background="{DynamicResource B.Overlay}" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20" MaxHeight="560">
                <Grid>
                    <!-- Đang chờ -->
                    <StackPanel x:Name="WaitPanel">
                        <StackPanel Orientation="Horizontal">
                            <c:Spinner/>
                            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="WaitTitle" Style="{StaticResource T.H2}" TextWrapping="Wrap" MaxWidth="500"/>
                                <TextBlock Text="{c:T 'Hãy làm theo hướng dẫn trong cửa sổ gỡ cài đặt của phần mềm. DrAn For Computer sẽ tự quét phần còn sót khi gỡ xong.'}"
                                           Style="{StaticResource T.Sub}" Margin="0,4,0,0" MaxWidth="500"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button Content="{c:T 'Hủy'}" Click="WaitCancel_Click" MinWidth="90"/>
                            <Button Content="{c:T 'Tôi đã gỡ xong'}" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="WaitDone_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Phần còn sót -->
                    <DockPanel x:Name="LeftoverPanel" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock x:Name="LeftoverTitle" Style="{StaticResource T.H2}"/>
                            <TextBlock Text="{c:T 'Các mục được chọn sẵn là trùng khớp chính xác với phần mềm. Thư mục sẽ được đưa vào Thùng rác, registry được sao lưu (.reg) trước khi xóa.'}"
                                       Style="{StaticResource T.Sub}" Margin="0,4,0,10"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="{c:T 'Bỏ qua'}" Click="LeftoverSkip_Click" MinWidth="90"/>
                            <Button Content="{c:T 'Xóa mục đã chọn'}" Style="{StaticResource Btn.Danger}" Margin="8,0,0,0" Click="LeftoverDelete_Click"/>
                        </StackPanel>
                        <ListBox x:Name="LeftoverList" Style="{StaticResource PlainList}" MaxHeight="320">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Row}" Padding="8,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                            <Border Grid.Column="1" Style="{StaticResource Badge}" Background="{DynamicResource B.Card2}" Margin="12,0,10,0" Width="70">
                                                <TextBlock Text="{Binding Kind}" FontSize="10.5" Foreground="{DynamicResource B.Text2}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource T.Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
