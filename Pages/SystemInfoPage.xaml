<UserControl x:Class="BacSiMayTinh.Pages.SystemInfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:BacSiMayTinh.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="SectionTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="20,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource B.AccentSoft}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource T.Icon}" Foreground="{DynamicResource B.Accent}" HorizontalAlignment="Center" FontSize="15"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.H3}" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="15"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource B.Accent}" Margin="0,10,0,2"
                                               TextWrapping="Wrap" Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}}"/>
                                    <Grid Margin="0,4" Visibility="{Binding IsHeader, Converter={StaticResource BoolVis}, ConverterParameter=!}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.42*"/>
                                            <ColumnDefinition Width="0.58*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasBrush}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding ValueBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Bars}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,6,0,6">
                                    <Grid>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource T.Muted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" Margin="0,6,0,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Warn}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding Brush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,0,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{c:T 'Thông tin máy'}" Style="{StaticResource T.H1}"/>
                <TextBlock x:Name="Subtitle" Text="{c:T 'Cấu hình phần cứng, sức khỏe ổ cứng, pin và hệ điều hành.'}" Style="{StaticResource T.Sub}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="RefreshBtn" Click="Refresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12"/>
                        <TextBlock Text="{c:T 'Làm mới'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyBtn" Margin="8,0,0,0" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource T.Icon}" FontSize="12"/>
                        <TextBlock Text="{c:T 'Sao chép'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportBtn" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0" Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE749;" Style="{StaticResource T.Icon}" FontSize="12"/>
                        <TextBlock Text="{c:T 'Xuất báo cáo'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="Loading" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <c:Spinner HorizontalAlignment="Center"/>
            <TextBlock Text="{c:T 'Đang thu thập thông tin phần cứng…'}" Style="{StaticResource T.Sub}" Margin="0,14,0,0"/>
        </StackPanel>

        <ScrollViewer x:Name="ContentArea" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ItemsControl x:Name="LeftCol" ItemTemplate="{StaticResource SectionTemplate}"/>
                <ItemsControl x:Name="RightCol" Grid.Column="2" ItemTemplate="{StaticResource SectionTemplate}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
